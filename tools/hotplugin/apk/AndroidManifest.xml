<?xml version="1.0" encoding="utf-8"?>
<!--
  热更新插件的最小清单。
  插件不注册任何组件（无 Activity/Service），只是一个承载 dex 的容器：
  壳通过 DexClassLoader 直接从它加载 entryClass。
  package 仅作标识，不参与安装（插件不会被 pm install）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.Johnny.wcx.hotplugin.probe">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="37" />

    <application
        android:hasCode="true"
        android:label="WCX Hot Probe" />

</manifest>
