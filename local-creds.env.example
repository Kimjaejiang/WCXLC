# Local signing credentials for fastbuild.bat / devrun.bat
#
# Copy this file to "local-creds.env" (same directory) and fill in your values.
# local-creds.env is gitignored and must never be committed.
#
# NOTE: keep this file ASCII-only.
#   fastbuild.bat reads it with `for /f`, which decodes the file using the
#   console code page (GBK on zh-CN Windows). Non-ASCII bytes get mis-decoded
#   and can corrupt line splitting, causing entries to be silently skipped.
#
# If these four variables are already set in the environment (CI does this),
# fastbuild.bat leaves them untouched.

WEKIT_KEYSTORE_FILE=D:\path\to\your-release.jks
WEKIT_KEYSTORE_PASSWORD=change-me
WEKIT_KEY_ALIAS=your-alias
WEKIT_KEY_PASSWORD=change-me
